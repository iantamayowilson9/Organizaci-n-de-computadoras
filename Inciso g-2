section .data
    num1    db 5
    num2    db 11
    result  db 0
    msg     db 'Resultado: ', 0

section .bss
    buffer  resb 4

section .text
    global _start

_start:
    ; --- Se mantiene la suma original ---
    mov al, [num1]
    add al, [num2]
    mov [result], al

    ; --- Direccionamiento indirecto: se carga puntero y se escribe '@' ---
    lea esi, [buffer]         ; cargar la dirección de buffer en ESI
    mov byte [esi], '@'       ; indirecto: escribir en la dirección apuntada por ESI

    ; Imprimir "Resultado: "
    mov eax, 4
    mov ebx, 1
    mov ecx, msg
    mov edx, 11
    int 0x80

    ; Imprimir el carácter en buffer (usando la misma dirección)
    mov eax, 4
    mov ebx, 1
    mov ecx, buffer
    mov edx, 1
    int 0x80

    ; Salir
    mov eax, 1
    xor ebx, ebx
    int 0x80

Programa 4 — Imprimir =

section .data
    char db 0
    newline db 10

section .text
    global _start

_start:
    ; ASCII '=' = 61
    mov al, 122
    ror al, 1          ; rotar derecha 122 -> 61

    mov [char], al

    ; imprimir
    mov eax, 4
    mov ebx, 1
    mov ecx, char
    mov edx, 1
    int 0x80

    ; salto de línea
    mov eax, 4
    mov ebx, 1
    mov ecx, newline
    mov edx, 1
    int 0x80

    ; salir
    mov eax, 1
    xor ebx, ebx
    int 0x80

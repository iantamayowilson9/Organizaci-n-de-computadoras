// Modifica el programa para que imprima lo siguiente: A, \, $, & y 1. Documenta tu procedimiento.

section .data
    msg     db 'Resultado: ', 0    ; mensaje a imprimir
    msg_len equ $ - msg            ; longitud calculada de msg

section .bss
    buffer  resb 4                 ; buffer para almacenar 1 carácter (y algo de espacio)

section .text
    global _start

_start:
    ; Imprimir "Resultado: "
    mov eax, 4         ; sys_write
    mov ebx, 1         ; stdout
    mov ecx, msg
    mov edx, msg_len
    int 0x80

    ; --- Imprimir 'A' ---
    mov byte [buffer], 'A'    ; escribir carácter inmediato en buffer
    mov eax, 4
    mov ebx, 1
    mov ecx, buffer
    mov edx, 1
    int 0x80

    ; --- Imprimir '\' (backslash) ---
    mov byte [buffer], '\'    ; escape con comilla simple en ensamblador
    mov eax, 4
    mov ebx, 1
    mov ecx, buffer
    mov edx, 1
    int 0x80

    ; --- Imprimir '$' ---
    mov byte [buffer], '$'
    mov eax, 4
    mov ebx, 1
    mov ecx, buffer
    mov edx, 1
    int 0x80

    ; --- Imprimir '&' ---
    mov byte [buffer], '&'
    mov eax, 4
    mov ebx, 1
    mov ecx, buffer
    mov edx, 1
    int 0x80

    ; --- Imprimir '1' ---
    mov byte [buffer], '1'
    mov eax, 4
    mov ebx, 1
    mov ecx, buffer
    mov edx, 1
    int 0x80

    ; Salir del programa
    mov eax, 1
    xor ebx, ebx
    int 0x80

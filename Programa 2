Programa 2 — Imprimir 0

section .data
    char db 0
    newline db 10

section .text
    global _start

_start:
    ; ASCII '0' = 48
    mov al, 3
    shl al, 4          ; 3 << 4 = 48

    mov [char], al

    ; imprimir
    mov eax, 4
    mov ebx, 1
    mov ecx, char
    mov edx, 1
    int 0x80

    ; salto de línea
    mov eax, 4
    mov ebx, 1
    mov ecx, newline
    mov edx, 1
    int 0x80

    ; salir
    mov eax, 1
    xor ebx, ebx
    int 0x80
